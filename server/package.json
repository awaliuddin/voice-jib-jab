{
  "name": "@voice-jib-jab/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "coverage:check": "jest --coverage --coverageReporters=text-summary",
    "build:policy": "bash ../scripts/build-policy.sh",
    "demo:support": "DEMO_SCENARIO=support tsx src/index.ts",
    "demo:compliance": "DEMO_SCENARIO=compliance tsx src/index.ts",
    "demo:sales": "DEMO_SCENARIO=sales tsx src/index.ts",
    "demo:play": "tsx src/demo/run.ts",
    "demo:play:support": "tsx src/demo/run.ts support",
    "demo:play:compliance": "tsx src/demo/run.ts compliance",
    "demo:play:sales": "tsx src/demo/run.ts sales",
    "load-test": "npx tsx ../tests/load/advanced-load-test.ts",
    "load-test:full": "npx tsx ../tests/load/advanced-load-test.ts --concurrency 5,10,25,50,100,200,300,500",
    "test:load": "artillery run load-tests/api.yml",
    "test:load:health": "artillery run load-tests/health.yml",
    "test:load:shutdown": "bash load-tests/graceful-shutdown.sh"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@open-policy-agent/opa-wasm": "^1.10.0",
    "better-sqlite3": "^12.6.0",
    "chromadb": "^3.3.3",
    "dotenv": "^16.4.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "openai": "^6.42.0",
    "prom-client": "^15.1.3",
    "uuid": "^9.0.1",
    "ws": "^8.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/jest-runner": "^9.6.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.17",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "fast-check": "^4.6.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.7.0",
    "typescript": "^6.0.0"
  }
}
